@startuml class-diagram
title Multi-Client Chat - Class Diagram
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "TCPServer (Maven project)" {
  class TCPServer <<launcher>> {
    + {static} main(args : String[]) : void
  }

  package "server.config" {
    class ServerConfig <<record>> {
      + host : String
      + port : int
      + {static} load() : ServerConfig
    }
  }

  package "server.model" {
    interface ServerListener {
      + onLog(message : String) : void
      + onUserJoined(username : String, readOnly : boolean) : void
      + onUserLeft(username : String) : void
    }

    class ChatServer {
      - port : int
      - clients : Set<ClientHandler>
      - users : Map<String, ClientHandler>
      - serverSocket : ServerSocket
      - running : boolean
      + start() : void
      + stop() : void
      - acceptLoop() : void
      ~ register(h : ClientHandler, name : String) : void
      ~ broadcast(line : String) : void
      ~ format(user : String, text : String) : String
      ~ activeUsersMessage() : String
      ~ remove(h : ClientHandler) : void
    }

    class ClientHandler implements Runnable {
      - socket : Socket
      - out : PrintWriter
      - username : String
      - readOnly : boolean
      + run() : void
      ~ send(line : String) : void
      ~ close() : void
    }
  }

  package "server.view" {
    class ServerApp extends javafx.application.Application {
      - logArea : TextArea
      - users : ObservableList<String>
      - userColors : Map<String, String>
      + start(stage : Stage) : void
      + stop() : void
    }
  }

  TCPServer ..> ServerApp : launches
  ServerApp ..|> ServerListener
  ServerApp --> ChatServer : creates / controls
  ServerApp ..> ServerConfig : reads port
  ChatServer o-- "0..*" ClientHandler : manages
  ClientHandler --> ChatServer : register / broadcast / remove
  ChatServer --> ServerListener : notifies
}

package "TCPClient (Maven project)" {
  class TCPClient <<launcher>> {
    + {static} main(args : String[]) : void
  }

  package "client.config" {
    class ClientConfig <<record>> {
      + host : String
      + port : int
      + {static} resolve(args : List<String>) : ClientConfig
    }
  }

  package "client.model" {
    interface MessageListener {
      + onMessage(line : String) : void
      + onDisconnected() : void
    }

    class ChatClient {
      - host : String
      - port : int
      - socket : Socket
      - out : PrintWriter
      - username : String
      - readOnly : boolean
      - connected : AtomicBoolean
      + connect(username : String) : void
      + send(text : String) : void
      + disconnect() : void
      - receiveLoop(in : BufferedReader) : void
    }
  }

  package "client.view" {
    class ClientApp extends javafx.application.Application {
      - messages : ObservableList<String>
      - statusDot : Circle
      - statusLabel : Label
      - input : TextArea
      + start(stage : Stage) : void
      - buildLoginScene() : Scene
      - buildChatScene() : Scene
    }
  }

  TCPClient ..> ClientApp : launches
  ClientApp ..|> MessageListener
  ClientApp --> ChatClient : creates / controls
  ClientApp ..> ClientConfig : resolves address
  ChatClient --> MessageListener : notifies
}

ChatClient ..> ClientHandler : TCP text lines (port 3000)
@enduml
