@startuml sequence-diagram
title Multi-Client Chat - Join, message, allUsers, leave

actor Alice
participant "ClientApp\n(view)" as AView
participant "ChatClient\n(model)" as AClient
participant "ChatServer" as Server
participant "ClientHandler\n(alice)" as AHandler
participant "ClientHandler\n(bob)" as BHandler
participant "ServerApp\n(view)" as SView

== Join ==
Alice -> AView : enter "alice", Join
AView -> AClient : connect("alice")
AClient -> Server : TCP connect
Server -> AHandler : new + start virtual thread
AClient -> AHandler : "alice"
AHandler -> Server : register(alice)
Server -> SView : onLog("Welcome alice"), onUserJoined
Server -> AHandler : send("SYSTEM: Connected as alice")
Server -> BHandler : send("*** alice joined the chat ***")

== Chat message ==
Alice -> AView : type "hi", Enter / SEND
AView -> AClient : send("hi")
AClient -> AHandler : "hi"
AHandler -> Server : broadcast(format(alice, "hi"))
Server -> AHandler : "[alice 14:05] hi"
Server -> BHandler : "[alice 14:05] hi"
AHandler --> AClient : "[alice 14:05] hi"
AClient --> AView : onMessage(...)

== allUsers ==
Alice -> AClient : send("allUsers")
AClient -> AHandler : "allUsers"
AHandler -> AClient : "SYSTEM: Active users (2): alice, bob"
note right : only the asking client gets the reply

== Leave ==
Alice -> AView : LEAVE (or "bye" / "end")
AView -> AClient : disconnect()
AClient -> AHandler : "bye"
AHandler -> Server : remove(alice)
Server -> SView : onLog("alice left the chat"), onUserLeft
Server -> BHandler : "*** alice left the chat ***"
AClient --> AView : onDisconnected() -> "Offline"
@enduml
